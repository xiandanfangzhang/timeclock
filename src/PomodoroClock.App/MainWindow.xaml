<Window x:Class="PomodoroClock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="番茄时钟" Width="1100" Height="720" MinWidth="760" MinHeight="600"
        Background="{StaticResource AppBackground}" Closing="Window_Closing">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="18,24,16,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource Tomato}"><TextBlock Text="25" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Margin="11,0,0,0"><TextBlock Text="番茄时钟" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="专注每一刻" FontSize="11" Foreground="{StaticResource InkMuted}" Margin="0,2,0,0"/></StackPanel>
          </StackPanel>
          <Border Height="1" Background="{StaticResource Line}" Margin="0,24,0,16"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="工作台" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMuted}" Margin="10,0,0,8"/>
          <Button Content="番茄时钟" Click="NavTimer" Style="{StaticResource NavButtonStyle}"/>
          <Button Content="工作事项" Click="NavTasks" Style="{StaticResource NavButtonStyle}"/>
          <Button Content="统计" Click="NavStats" Style="{StaticResource NavButtonStyle}"/>
          <TextBlock Text="偏好设置" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkMuted}" Margin="10,24,0,8"/>
          <Button Content="设置" Click="NavSettings" Style="{StaticResource NavButtonStyle}"/>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <Border Background="{StaticResource TomatoSoft}" CornerRadius="12" Padding="13" Margin="0,0,0,14"><StackPanel><TextBlock Text="保持轻盈" FontWeight="SemiBold"/><TextBlock Text="专注数据只保存在本机" FontSize="12" Foreground="{StaticResource InkMuted}" Margin="0,4,0,0"/></StackPanel></Border>
          <TextBlock Text="本地运行 · 无需联网" FontSize="11" Foreground="{StaticResource InkMuted}" Margin="4,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,28,32,28">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,20">
        <TextBlock DockPanel.Dock="Right" Text="●  本地已保存" Foreground="{StaticResource BreakGreen}" VerticalAlignment="Center" FontSize="12" Margin="16,0,0,0"/>
        <StackPanel><TextBlock x:Name="PageEyebrow" Text="今天 · 专注模式" FontSize="12" Foreground="{StaticResource Tomato}" FontWeight="SemiBold"/><TextBlock x:Name="PageTitle" Text="开始一轮专注" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
      </DockPanel>
      <TabControl x:Name="Pages" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="Pages_SelectionChanged">
        <TabControl.ItemContainerStyle><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.ItemContainerStyle>
        <TabItem Header="番茄时钟">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="28" Margin="0,0,0,18">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center"><TextBlock Text="当前阶段" FontSize="12" Foreground="{StaticResource InkMuted}"/><TextBlock x:Name="PhaseText" Text="专注" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="RoundsText" Text="本周期已完成 0 轮" FontSize="13" Foreground="{StaticResource InkMuted}" Margin="0,8,0,0"/><Border Background="{StaticResource TomatoSoft}" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left" Margin="0,18,0,0"><TextBlock Text="连续专注 · 不可暂停" Foreground="{StaticResource TomatoDark}" FontSize="12"/></Border></StackPanel>
                  <TextBlock x:Name="TimeText" Grid.Column="1" Text="25:00" FontSize="72" FontWeight="Light" Foreground="{StaticResource Tomato}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
              </Border>
              <Border Grid.Row="1" MinHeight="150" Background="{StaticResource SurfaceSubtle}" CornerRadius="18" Padding="28"><StackPanel VerticalAlignment="Center"><TextBlock Text="准备好了吗？" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="完成后你可以把这一轮关联到一个或多个工作事项。" FontSize="13" Foreground="{StaticResource InkMuted}" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center"/></StackPanel></Border>
              <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,18,0,0" ItemHeight="44">
                <Button x:Name="StartButton" Content="开始专注" Click="StartClick" Style="{StaticResource PrimaryButtonStyle}" MinWidth="150" Margin="4"/>
                <Button Content="提前结束" Click="CancelClick" Style="{StaticResource SecondaryButtonStyle}" Margin="4"/>
                <Button Content="重置" Click="ResetClick" Style="{StaticResource SecondaryButtonStyle}" Margin="4"/>
                <Button Content="跳过休息" Click="SkipClick" Style="{StaticResource SecondaryButtonStyle}" Margin="4"/>
              </WrapPanel>
            </Grid>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="工作事项">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16">
              <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top"><Button Content="新建事项" Click="NewTaskClick" Style="{StaticResource PrimaryButtonStyle}" Margin="4,0,0,4"/><ComboBox x:Name="StatusFilter" Width="120" Margin="10,0,0,4" SelectionChanged="ReloadTasks" Padding="8"><ComboBoxItem Content="全部" IsSelected="True"/><ComboBoxItem Content="进行中"/><ComboBoxItem Content="已完成"/></ComboBox></WrapPanel>
              <StackPanel><TextBlock Text="工作事项" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="把想法拆成下一步行动" FontSize="13" Foreground="{StaticResource InkMuted}" Margin="0,4,0,0"/></StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="8"><ListView x:Name="TasksList" Background="Transparent" BorderThickness="0"><ListView.View><GridView><GridViewColumn Header="事项" DisplayMemberBinding="{Binding Title}" Width="300"/><GridViewColumn Header="优先级" DisplayMemberBinding="{Binding Priority}" Width="110"/><GridViewColumn Header="参与番茄" DisplayMemberBinding="{Binding ParticipationCount}" Width="110"/><GridViewColumn Header="状态" DisplayMemberBinding="{Binding Status}" Width="110"/></GridView></ListView.View></ListView></Border>
          </Grid>
        </TabItem>
        <TabItem Header="统计">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="今日记录" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="每一次完整专注，都会留下清晰的轨迹" FontSize="13" Foreground="{StaticResource InkMuted}" Margin="0,4,0,0"/></StackPanel>
            <WrapPanel Grid.Row="1" Margin="0,20,0,18"><Border Background="{StaticResource TomatoSoft}" CornerRadius="14" Padding="20" MinWidth="180" Margin="0,0,12,12"><StackPanel><TextBlock Text="有效番茄" Foreground="{StaticResource InkMuted}"/><TextBlock x:Name="TodayPomodoros" Text="0" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TomatoDark}" Margin="0,5,0,0"/></StackPanel></Border><Border Background="{StaticResource BreakGreenSoft}" CornerRadius="14" Padding="20" MinWidth="180" Margin="0,0,12,12"><StackPanel><TextBlock Text="专注时长" Foreground="{StaticResource InkMuted}"/><TextBlock x:Name="TodayMinutes" Text="0 分钟" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource BreakGreen}" Margin="0,5,0,0"/></StackPanel></Border></WrapPanel>
            <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="8"><ListView x:Name="SessionsList" Background="Transparent" BorderThickness="0"><ListView.View><GridView><GridViewColumn Header="开始" DisplayMemberBinding="{Binding Session.StartedUtc}" Width="220"/><GridViewColumn Header="结束" DisplayMemberBinding="{Binding Session.EndedUtc}" Width="220"/><GridViewColumn Header="关联事项" DisplayMemberBinding="{Binding WorkItems}" Width="300"/></GridView></ListView.View></ListView></Border>
          </Grid>
        </TabItem>
        <TabItem Header="设置">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
              <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="计时节奏和应用行为" FontSize="13" Foreground="{StaticResource InkMuted}" Margin="0,4,0,20"/>
              <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="24">
                <StackPanel>
                  <TextBlock Text="计时设置" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Text="调整后将在下一阶段生效。" FontSize="13" Foreground="{StaticResource InkMuted}" Margin="0,4,0,20"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,16,16"><Label Content="专注时长（分钟）" Target="{Binding ElementName=FocusBox}" Padding="0,0,0,6"/><TextBox x:Name="FocusBox" MaxLength="3"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,0,16"><Label Content="短休息时长（分钟）" Target="{Binding ElementName=ShortBox}" Padding="0,0,0,6"/><TextBox x:Name="ShortBox" MaxLength="2"/></StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,16,0"><Label Content="长休息时长（分钟）" Target="{Binding ElementName=LongBox}" Padding="0,0,0,6"/><TextBox x:Name="LongBox" MaxLength="3"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1"><Label Content="几轮后进入长休息" Target="{Binding ElementName=RoundsBox}" Padding="0,0,0,6"/><TextBox x:Name="RoundsBox" MaxLength="2"/></StackPanel>
                  </Grid>
                  <WrapPanel Margin="0,24,0,0"><Button Content="保存设置" Click="SaveSettingsClick" Style="{StaticResource PrimaryButtonStyle}" MinWidth="120" Margin="0,0,12,0"/><TextBlock x:Name="SettingsMessage" Foreground="{StaticResource TomatoDark}" VerticalAlignment="Center" MaxWidth="480"/></WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>
